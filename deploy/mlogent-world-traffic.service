[Unit]
Description=Mindustry in-memory traffic and fallback flight recorder
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/mlogent-ops
Environment=MLOGENT_ROOT=/opt/mlogent
ExecStart=/opt/uv-python/cpython-3.12-linux-x86_64-gnu/bin/python3.12 -m mlogent_ops.world_traffic --interface eth0 --port 6567 --sample-seconds 1 --incident-dir /var/log/mlogent-world-traffic/incidents --event-file /opt/mlogent/out/_world/aoi-fallback.json --status-file /run/mlogent-world-recorder/status.json
Restart=on-failure
RestartSec=5
UMask=0077
LogsDirectory=mlogent-world-traffic
RuntimeDirectory=mlogent-world-recorder
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_PACKET AF_UNIX AF_INET
MemoryMax=64M
CPUQuota=5%
Nice=10

[Install]
WantedBy=multi-user.target
